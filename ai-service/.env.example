# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Groq LLM API Key (can also be read directly from ../backend/.env)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://seam-context-ai.vercel.app

# Path to ONNX Intent Classification Model
MODEL_DIR=../../backend/classifier/model

